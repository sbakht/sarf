# Copy to `.env` and adjust. Compose reads this file for substitution.
# `docker compose` loads `.env` automatically; you do not need to export these.
#
# NEXT_PUBLIC_* is inlined at `docker build`. When you add any, pass them as
# Compose `build.args` (and Dockerfile ARG). Runtime secrets stay in `environment:`
# or Docker/K8s secrets — never `ENV` in the Dockerfile.

# --- App ---
# Host port mapped to the container's 3000. Inside Compose, HOSTNAME/PORT are
# set by the image (0.0.0.0:3000). Host `npm run dev` still uses package.json (3002).
APP_PORT=3002

# --- Postgres ---
POSTGRES_USER=sarf
POSTGRES_PASSWORD=sarf
POSTGRES_DB=sarf
POSTGRES_PORT=5432
# Host `npm run dev` talks to localhost. The `web` service overrides this to
# hostname `db` so the container always uses Compose DNS.
DATABASE_URL=postgresql://sarf:sarf@localhost:5432/sarf

# --- Redis (docker compose --profile redis up) ---
# REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# --- Auth (later) ---
# AUTH_SECRET=
# AUTH_URL=http://localhost:3002

# --- Object storage (later, S3 or MinIO) ---
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
