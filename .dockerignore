# Dependencies (installed inside Docker, never copied)
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build outputs (always generated during `next build`)
.next/
out/
dist/
build/
.vercel/

# Tests and testing output (not needed in production images)
coverage/
.nyc_output/
.vitest/
vitest.config.*
*.test.*
*.spec.*

# Local development and editor files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log

# Environment variables — keep credentials out of the build context.
# NEXT_PUBLIC_* belongs in Compose build.args when you add them; runtime
# secrets go in `environment:` / Docker secrets, never the image.
.env
.env*.local
.env.development
.env.test
.env.production.local

# Docker configuration files (not needed inside build context)
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*.yaml
docker-compose*.yml

# Documentation
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# Cache directories and temporary data
.cache/
.eslintcache
.swc/
.turbo/
.tmp/
.temp/

# TypeScript build metadata
*.tsbuildinfo

# Sensitive or unnecessary configuration files
*.pem

# OS-specific junk
.DS_Store
._*
Thumbs.db

# AI tool metadata
.cursor/
.cursorrules
AGENTS.md
CLAUDE.md
.agents/
.claude
